# Copy to ".env" and paste your key. Get it at platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides
CHAT_MODEL=gpt-5.4-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts

# Optional - Wispr Flow speech-to-text (invite-only API: platform.wisprflow.ai)
# If empty, OpenAI is used for speech-to-text.
WISPR_API_KEY=
WISPR_LANGUAGE=en

# Optional - Groq speech-to-text (FREE, very fast). Get it at console.groq.com/keys
GROQ_API_KEY=

# Image generation - Google Gemini. Get it at aistudio.google.com/apikey
# (image models need billing enabled; if empty or failing, OpenAI makes the image)
GEMINI_API_KEY=

# Video generation - Runway. Get it at dev.runwayml.com (buy credits first)
RUNWAY_API_KEY=
